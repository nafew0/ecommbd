# Every variable is checked at startup (src/env-schema.ts): the server refuses to start and
# lists the problems if one is missing or invalid.

# dev | test | staging | production
APP_ENV=dev
VENDURE_SERVER_PORT=3000
# At least 32 characters. Generate with: openssl rand -hex 32
COOKIE_SECRET=
# In staging and production the password must be at least 16 characters and not "superadmin".
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=superadmin
# Comma-separated list of browser origins allowed to make credentialed API requests,
# e.g. https://example.com,https://admin.example.com
# Only used when APP_ENV is not "dev". Leave empty in local development.
CORS_ORIGINS=
# Public URL of /assets/, e.g. https://shop.example.com/assets/ (required in staging and production)
ASSET_URL_PREFIX=

# PostgreSQL (root docker-compose.yml)
DB_HOST=127.0.0.1
DB_PORT=54320
DB_NAME=ecommbd
DB_USERNAME=ecommbd
DB_PASSWORD=ecommbd

# Redis: each store gets its own key prefix (required in staging and production)
REDIS_KEY_PREFIX=ecommbd-dev
REDIS_QUEUE_HOST=127.0.0.1
REDIS_QUEUE_PORT=63790
REDIS_CACHE_HOST=127.0.0.1
REDIS_CACHE_PORT=63791
# Production only: per-store Redis ACL users
# REDIS_QUEUE_USERNAME=
# REDIS_QUEUE_PASSWORD=
# REDIS_CACHE_USERNAME=
# REDIS_CACHE_PASSWORD=

# The storefront's default language for a new store: bn | en (default bn). Used once, when the store
# is first set up; afterwards the merchant changes it in Store settings.
STORE_DEFAULT_LANGUAGE=bn

# Where the storefront's WebP image sizes are written (served at /img; by Nginx in production).
# Default: apps/core/static/images. Recreate them with: npm run images:regenerate -- --all
# IMAGES_DIR=

# Logging: error | warn | info | verbose | debug
LOG_LEVEL=info
# json | pretty. Default: pretty in dev and test, json in staging and production
LOG_FORMAT=
# Added to every JSON log line when set (provisioning sets these per store)
STORE_ID=
RELEASE_VERSION=
