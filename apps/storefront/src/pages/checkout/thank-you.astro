---
import CheckoutSummary from '../../components/CheckoutSummary.astro';
import Icon from '../../components/Icon.astro';
import Layout from '../../layouts/Layout.astro';
import { shopperContext } from '../../lib/cart';
import { placedOrderByCode } from '../../lib/checkout';
import { purchaseEvents } from '../../lib/meta';
import { canonicalRedirect, pageContext, privatePage } from '../../lib/page';

/**
 * After the order (roadmap phase 14). Only the session that placed it can read it, for 2 hours
 * (Vendure's order-by-code rules); anyone else, a mistyped code or a later visit gets "track it
 * with your number and phone". `again=1`: the checkout found the order placed already (the back
 * button, another tab, a retry), so the heading says so instead of thanking for a new one.
 */
const redirect = canonicalRedirect(Astro, '/checkout/thank-you/');
if (redirect) return redirect;
privatePage(Astro);
const { settings, s, href, format } = pageContext(Astro);
const shopper = shopperContext(Astro);
const code = Astro.url.searchParams.get('order') ?? '';
const placed = await placedOrderByCode(shopper, code);
const again = Astro.url.searchParams.get('again') === '1';
shopper.session.apply(Astro.response.headers);
const number = placed?.customFields?.orderNumber ?? placed?.code ?? '';
const cod = placed?.payments?.some(payment => payment.method === 'bd-cod') ?? false;
const mfsPending = placed?.payments?.some(
    payment => payment.method !== 'bd-cod' && payment.state === 'Authorized',
);
const whatsapp = settings.profile.whatsapp.replace(/\D/g, '');
// Meta (phase 20): Purchase from the browser only when the store sends it on placing; its ID is the
// server's too, so Meta keeps one. With "confirmed" or "delivered" this page sends no Purchase.
const metaEvents = purchaseEvents(placed, Astro.locals.meta);
---

<Layout title={s.thankYouTitle} noindex metaEvents={metaEvents}>
    <section class="thank-you">
        {
            placed ? (
                <>
                    <p class="thank-you-mark" aria-hidden="true">
                        <Icon name="bag" size={32} />
                    </p>
                    <h1>{again ? s.alreadyPlaced : s.thankYouTitle}</h1>
                    <p class="thank-you-number">{s.orderNumberIs(number)}</p>
                    <p>{s.nextSteps}</p>
                    {mfsPending && <p>{s.mfsPending}</p>}
                    <div class="thank-you-actions">
                        {placed.bdTrackingToken && (
                            <a class="button" href={href(`/t/${placed.bdTrackingToken}/`)}>
                                {s.trackThisOrder}
                            </a>
                        )}
                        {whatsapp && (
                            <a
                                class="button button-whatsapp"
                                href={`https://wa.me/${whatsapp}?text=${encodeURIComponent(s.whatsappAboutOrder(number))}`}
                                rel="noopener"
                            >
                                <Icon name="whatsapp" />
                                {s.messageUs}
                            </a>
                        )}
                        <a class="text-link" href={href('/')}>
                            {s.continueShopping}
                        </a>
                    </div>
                    <CheckoutSummary order={placed} options={null} cod={cod} deliveryKnown />
                    <p class="muted">
                        {s.payOnDelivery}:{' '}
                        {format.price(
                            (placed.payments ?? [])
                                .filter(payment => payment.method === 'bd-cod' && payment.state === 'Authorized')
                                .reduce((sum, payment) => sum + payment.amount, 0),
                        )}
                    </p>
                </>
            ) : (
                <>
                    <h1>{s.trackTitle}</h1>
                    <p>{s.orderNotFound}</p>
                    <a class="button" href={href('/track/')}>
                        {s.trackButton}
                    </a>
                </>
            )
        }
    </section>
</Layout>
