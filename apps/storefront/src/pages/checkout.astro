---
import AddressFields from '../components/checkout/AddressFields.astro';
import ContactFields from '../components/checkout/ContactFields.astro';
import DeliveryChoice from '../components/checkout/DeliveryChoice.astro';
import OtpStep from '../components/checkout/OtpStep.astro';
import PaymentChoice from '../components/checkout/PaymentChoice.astro';
import CheckoutSummary from '../components/CheckoutSummary.astro';
import Layout from '../layouts/Layout.astro';
import { activeOrder, applyCartCookies, shopperContext } from '../lib/cart';
import {
    type CheckoutErrors,
    type CheckoutValues,
    initialValues,
    MFS_PROVIDERS,
    placeOnce,
    quote,
    readValues,
    saveProgress,
} from '../lib/checkout';
import { CHECKOUT_SETTINGS, DISTRICTS, THANAS } from '../lib/checkout-queries';
import { shopQuery } from '../lib/core';
import { csrfToken, formStamp, isSameSite, verifyCsrf } from '../lib/csrf';
import { canonicalRedirect, pageContext, privatePage } from '../lib/page';
import { LAST_ORDER_COOKIE, lastOrderCookie, parseCookies } from '../lib/session';

/**
 * The one-page checkout (roadmap phase 14). Never cached. A plain form that works without
 * JavaScript: "Update total" re-renders with the chosen district's thanas and charges, "Place
 * order" runs every step on the server (src/lib/checkout.ts). The script (src/scripts/checkout.ts)
 * sends the same form with fetch and swaps in the answer.
 */
const redirect = canonicalRedirect(Astro, '/checkout/');
if (redirect) return redirect;
privatePage(Astro);
const { lang, s, href, format } = pageContext(Astro);
const shopper = shopperContext(Astro);
const lastOrder = parseCookies(Astro.request.headers.get('cookie')).get(LAST_ORDER_COOKIE);
const thankYou = (code: string) => href(`/checkout/thank-you/?order=${encodeURIComponent(code)}`);
const go = (location: string, extra: string[] = []) => {
    const headers = new Headers({ location, 'cache-control': 'no-store' });
    shopper.session.apply(headers);
    for (const cookie of extra) headers.append('set-cookie', cookie);
    return new Response(null, { status: 303, headers });
};

let values: CheckoutValues;
let errors: CheckoutErrors = {};
let notice: string | null = null;
let otp: { message: string; error?: string } | null = null;
let idempotencyKey: string = crypto.randomUUID();
let stamp = formStamp();

if (Astro.request.method === 'POST') {
    if (!isSameSite(Astro.request)) return new Response(null, { status: 403 });
    const form = await Astro.request.formData();
    values = readValues(form);
    const postedKey = form.get('idempotencyKey');
    if (typeof postedKey === 'string' && /^[\w-]{16,128}$/.test(postedKey)) idempotencyKey = postedKey;
    if (typeof form.get('stamp') === 'string') stamp = String(form.get('stamp'));
    const action = form.get('action') ?? 'place';
    if (!verifyCsrf(form.get('csrf'), shopper.session.id)) {
        notice = s.sessionExpired;
    } else if (action === 'progress') {
        await saveProgress(shopper, form, {});
        const headers = new Headers({ 'cache-control': 'no-store' });
        shopper.session.apply(headers);
        return new Response(null, { status: 204, headers });
    } else if (action === 'place') {
        const outcome = await placeOnce(shopper, form, s);
        if (outcome.kind === 'placed') {
            return go(thankYou(outcome.code), [lastOrderCookie(outcome.code), 'cart_count=0; Path=/; Max-Age=0; SameSite=Lax']);
        }
        if (outcome.kind === 'empty') return go(lastOrder ? thankYou(lastOrder) : href('/cart/'));
        if (outcome.kind === 'invalid') errors = outcome.errors;
        if (outcome.kind === 'review') notice = outcome.message;
        if (outcome.kind === 'busy') notice = s.busy;
        if (outcome.kind === 'otp') otp = { message: outcome.message, error: outcome.error };
        if (Object.keys(errors).length && !errors.form) errors.form = s.fixFields;
    }
} else {
    const order = await activeOrder(shopper);
    // The back button after ordering, or a second tab: the order, not an empty checkout.
    if (!order?.lines.length) return go(lastOrder ? thankYou(lastOrder) : href('/cart/'));
    values = initialValues(order);
}

const [{ order, shipping, options }, { bdCheckoutSettings: settings }, { bdDistricts: districts }] = await Promise.all([
    quote(shopper, values),
    shopQuery(CHECKOUT_SETTINGS, {}, lang),
    shopQuery(DISTRICTS, { lang }, lang),
]);
// Everything sold out while checking out: say so instead of sending the shopper to an empty cart.
if (!order) return go(lastOrder ? thankYou(lastOrder) : href('/cart/'));
const soldOutNotice = !order.lines.length && errors.form ? errors.form : null;
if (!order.lines.length && !soldOutNotice) return go(lastOrder ? thankYou(lastOrder) : href('/cart/'));
const thanas = values.districtId ? (await shopQuery(THANAS, { districtId: values.districtId, lang }, lang)).bdThanas : [];
applyCartCookies(Astro.response.headers, shopper, order);

const deliveryKnown = !!values.districtId && !!values.thanaId && shipping.length > 0;
const chosenShipping = order.shippingLines[0]?.shippingMethod.id;
const cod = values.payment !== '' && !MFS_PROVIDERS.includes(values.payment as never);
const free = order.bdDelivery.freeDeliveryRemaining;
---

{
    soldOutNotice ? (
        <Layout title={s.checkoutTitle} noindex>
            <section class="cart-page">
                <h1>{s.checkoutTitle}</h1>
                <p class="form-alert" role="alert">
                    {soldOutNotice}
                </p>
                <p>
                    <a class="button" href={href('/')}>
                        {s.continueShopping}
                    </a>
                </p>
            </section>
        </Layout>
    ) : (
<Layout title={s.checkoutTitle} noindex>
    <div class="checkout" data-checkout>
        <h1>{s.checkoutTitle}</h1>
        <form method="post" action={href('/checkout/')} class="checkout-form" novalidate data-checkout-form>
            <input type="hidden" name="csrf" value={csrfToken(shopper.session.id)} />
            <input type="hidden" name="idempotencyKey" value={idempotencyKey} />
            <input type="hidden" name="stamp" value={stamp} />
            <input type="hidden" name="expectedTotal" value={order.totalWithTax} />
            <div class="honeypot" aria-hidden="true">
                <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
            </div>

            {
                (errors.form || notice) && (
                    <div class="form-alert" role="alert" tabindex="-1" data-form-alert>
                        {errors.form ?? notice}
                    </div>
                )
            }

            <div class="checkout-main">
                <ContactFields values={values} errors={errors} settings={settings} />

                <AddressFields values={values} errors={errors} settings={settings} districts={districts} thanas={thanas} />

                <DeliveryChoice values={values} shipping={shipping} chosenShipping={chosenShipping} free={free} deliveryKnown={deliveryKnown} />

                <PaymentChoice values={values} errors={errors} options={options} order={order} cod={cod} />

                <OtpStep otp={otp} />
            </div>

            <aside class="checkout-aside">
                <CheckoutSummary order={order} options={options} cod={cod} deliveryKnown={deliveryKnown} />
            </aside>

            <div class="checkout-actions">
                <button class="button place-button" type="submit" name="action" value="place" data-place data-placing={s.placing}>
                    {s.placeOrder(format.price(order.totalWithTax))}
                </button>
                <p class="form-status" role="status" aria-live="polite" data-status data-offline={s.noConnection}></p>
            </div>
        </form>
    </div>
</Layout>
    )
}

<script>
    import { enhanceCheckout } from '../scripts/checkout';

    const form = document.querySelector<HTMLFormElement>('[data-checkout-form]');
    if (form) enhanceCheckout(form);
</script>
