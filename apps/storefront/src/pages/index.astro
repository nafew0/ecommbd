---
import { type Bilingual, pick } from '@ecommbd/sections';
import Layout from '../layouts/Layout.astro';
import { largestImageUrl } from '../lib/images';
import { alternates, canonicalRedirect, pageContext } from '../lib/page';
import { defaultHome, loadLayout, loadSectionData, setCacheTags, visibleSections } from '../lib/sections';
import { organization, website } from '../lib/seo';
import { bilingual, storeName } from '../lib/store';
import Sections from '../sections/Sections.astro';

/**
 * The home page: the merchant's sections (phase 15), or until they publish some, the default
 * layout (the store's name, the main categories, the newest products and the trust badges).
 */
const redirect = canonicalRedirect(Astro, '/');
if (redirect) return redirect;

const { lang, settings, s, href, absolute } = pageContext(Astro);
const layout = (await loadLayout(Astro, 'home')) ?? defaultHome(settings);
const sections = visibleSections(layout.document);
const data = await loadSectionData(Astro, sections);
if (!Astro.locals.preview) setCacheTags(Astro, layout, data);
const name = storeName(settings, lang);
const description = bilingual(settings.profile.shortDescription, lang);
const logo = settings.profile.logo ? largestImageUrl(settings.profile.logo) : undefined;
const profile = settings.profile;
// The first section's heading is the page's h1 when it opens the page (a hero, slideshow, banner or
// text with a heading); otherwise the store's name is, hidden.
const first = sections[0];
const firstHeading =
    first?.type === 'slideshow'
        ? (first.blocks[0]?.settings.heading as Bilingual | undefined)
        : (first?.settings.heading as Bilingual | undefined);
const headingFirst =
    ['hero', 'slideshow', 'banner', 'image-with-text', 'rich-text'].includes(first?.type ?? '') &&
    !!firstHeading &&
    !!pick(firstHeading, lang);
---

<Layout
    title=""
    description={description || s.homeDescription(name)}
    canonicalPath="/"
    alternates={alternates(Astro, { bn: '/', en: '/' })}
    image={logo}
    fullWidth
    structuredData={[
        organization({
            name,
            url: absolute(href('/')),
            logo: logo ? absolute(logo) : undefined,
            phones: profile.phones,
            email: profile.email,
            sameAs: Object.values(profile.social).filter(Boolean),
        }),
        website({ name, url: absolute(href('/')), searchUrl: absolute(href('/search/')), language: lang }),
    ]}
>
    {!headingFirst && <h1 class="visually-hidden">{name}</h1>}
    <Sections layout={layout} data={data} firstIsH1={headingFirst} />
</Layout>
