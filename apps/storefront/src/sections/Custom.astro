---
import { type SectionData, visibleNodes } from '@ecommbd/sections';
import { type SectionContext } from './context';
import Node from './Node.astro';
import EditorHint from './parts/EditorHint.astro';

/**
 * The free section (phase 56, the Custom section of phase 16 rebuilt): a tree of containers and
 * elements the merchant lays out and styles one by one, like a page builder. Node.astro draws
 * each node; the page's generated stylesheet lays them out. Shoppers see nothing for a hidden
 * node or an empty container.
 */
interface Props {
    section: SectionData;
    context: SectionContext;
}

const { section, context } = Astro.props;
const all = section.children ?? [];
const nodes = context.editor ? all.filter(node => !node.hidden) : visibleNodes(all);
---

{
    nodes.length === 0 ? (
        context.editor && (
            <div class="section-inner">
                <EditorHint text={context.s.editorAddElements} icon="box" />
            </div>
        )
    ) : (
        <div class="section-inner tree">
            {nodes.map(node => (
                <Node node={node} context={context} />
            ))}
        </div>
    )
}
