---
import '../styles/global.css';
import '../styles/themes.css';
import '../styles/sections.css';
import { hasDefaultColours, themeAttributes, themeVersion } from '@ecommbd/sections';
import FloatingContact from '../components/FloatingContact.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PreviewBar from '../components/PreviewBar.astro';
import PreviewTools from '../components/PreviewTools.astro';
import SalesFooter from '../components/SalesFooter.astro';
import SalesHeader from '../components/SalesHeader.astro';
import StickyOrderBar from '../components/StickyOrderBar.astro';
import { otherLang } from '../lib/i18n';
import type { ImageAttributes } from '../lib/images';
import { pageContext } from '../lib/page';
import { jsonLd } from '../lib/seo';
import { storeName } from '../lib/store';
import { sameOriginAssetUrl } from '../lib/urls';
import { env } from '../env';

interface Props {
    /** The page's own title; the store name is added after it. */
    title: string;
    description?: string;
    /** The canonical path in this language, without the prefix. Null for pages that mustn't be indexed. */
    canonicalPath?: string | null;
    alternates?: Array<{ hreflang: string; href: string }>;
    noindex?: boolean;
    ogType?: 'website' | 'product';
    /** An image path or URL for Open Graph and Twitter cards. */
    image?: string;
    structuredData?: unknown[];
    /** The main (LCP) image, preloaded in the head. */
    preload?: ImageAttributes & { sizes: string };
    /** Pages made of sections (phase 15) lay out their own width. */
    fullWidth?: boolean;
    /** The page's generated stylesheet (lib/sections.ts `pageStyle`), allowed by its hash in the CSP. */
    css?: string;
    /** A sales page (phase 16): its own header, footer, width and font, and the order bar. */
    sales?: {
        pageId: string;
        header: 'slim' | 'store' | 'none';
        footer: boolean;
        width: 'phone' | 'full';
        font: string;
        /** The sticky order bar on phones: the price it shows. */
        sticky: string | null;
    };
}

const {
    title,
    description,
    canonicalPath = null,
    alternates = [],
    noindex = false,
    ogType = 'website',
    image,
    structuredData = [],
    preload,
    fullWidth = false,
    css: pageCss = '',
    sales,
} = Astro.props;
const { lang, settings, s, href, absolute } = pageContext(Astro);
const name = storeName(settings, lang);
const fullTitle = title && title !== name ? `${title} | ${name}` : name;
const canonical = canonicalPath ? absolute(href(canonicalPath)) : null;
const other = otherLang(lang);
const switchHref = alternates.find(link => link.hreflang === other)?.href ?? href('/', other);
const favicon = settings.profile.favicon?.preview;
const phone = settings.profile.phones[0];
// The theme (phase 15): data attributes switch its look; custom colours come in a small stylesheet.
const theme = Astro.locals.theme;
const preview = Astro.locals.preview;
const editorOrigin = preview?.mode === 'editor' ? (env().EDITOR_ORIGIN ?? undefined) : undefined;
const htmlAttributes = { ...themeAttributes(theme), ...(sales?.font ? { 'data-font': sales.font } : {}) };
const header = sales?.header ?? 'store';
---

<!doctype html>
<html lang={lang} {...htmlAttributes}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{fullTitle}</title>
        {!hasDefaultColours(theme) && <link rel="stylesheet" href={`/theme.css?v=${themeVersion(theme)}`} />}
        {pageCss && <style is:inline data-layout-css set:html={pageCss} />}
        {description && <meta name="description" content={description} />}
        {(noindex || preview) && <meta name="robots" content="noindex, follow" />}
        {canonical && <link rel="canonical" href={canonical} />}
        {alternates.map(link => <link rel="alternate" hreflang={link.hreflang} href={link.href} />)}
        {
            favicon ? (
                <link rel="icon" href={`${sameOriginAssetUrl(favicon)}?preset=tiny`} />
            ) : (
                <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
            )
        }
        {
            preload && (
                <link
                    rel="preload"
                    as="image"
                    href={preload.src}
                    imagesrcset={preload.srcset}
                    imagesizes={preload.srcset ? preload.sizes : undefined}
                    fetchpriority="high"
                />
            )
        }
        <meta property="og:site_name" content={name} />
        <meta property="og:title" content={title || name} />
        {description && <meta property="og:description" content={description} />}
        <meta property="og:type" content={ogType} />
        {canonical && <meta property="og:url" content={canonical} />}
        <meta property="og:locale" content={lang === 'bn' ? 'bn_BD' : 'en_US'} />
        {image && <meta property="og:image" content={absolute(image)} />}
        <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
        <meta name="twitter:title" content={title || name} />
        {description && <meta name="twitter:description" content={description} />}
        {image && <meta name="twitter:image" content={absolute(image)} />}
        {structuredData.map(data => <script type="application/ld+json" set:html={jsonLd(data)} />)}
        <slot name="head" />
    </head>
    <body data-preview={preview?.mode} data-editor-origin={editorOrigin} data-sales-page={sales?.pageId}>
        <a class="skip-link" href="#main">{s.skipToContent}</a>
        {header === 'store' && <Header switchHref={switchHref} />}
        {header === 'slim' && <SalesHeader switchHref={switchHref} />}
        <main
            id="main"
            class:list={[fullWidth ? 'main-sections' : 'container', { 'main-sales': !!sales, 'main-phone': sales?.width === 'phone' }]}
        >
            <slot />
        </main>
        {sales ? sales.footer && <SalesFooter /> : <Footer />}
        {
            !sales && (
                <FloatingContact
                    lang={lang}
                    whatsapp={settings.profile.whatsapp}
                    messengerUrl={settings.profile.messengerUrl}
                    phone={phone}
                />
            )
        }
        {sales?.sticky && <StickyOrderBar price={sales.sticky} />}
        <PreviewBar />
        {preview?.mode === 'editor' && <PreviewTools />}
        <script>
            // Where the shopper came from (phase 16): a tiny script, on every page.
            import { recordVisit } from '../scripts/attribution';

            recordVisit();
        </script>
    </body>
</html>
