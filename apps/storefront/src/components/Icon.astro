---
/**
 * The storefront's own icons (CLAUDE.md, storefront design standard): drawn for us on one 24 px grid
 * with a 1.5 px stroke and square ends, no icon library. WhatsApp and Messenger are the services'
 * own marks, filled. Icons are decoration: the link or button around them carries the label.
 */
export type IconName =
    | 'search'
    | 'bag'
    | 'menu'
    | 'close'
    | 'chevron-down'
    | 'chevron-left'
    | 'chevron-right'
    | 'filter'
    | 'image'
    | 'phone'
    | 'whatsapp'
    | 'messenger'
    // Sections (phase 15): trust badges, columns, contact, slideshow and video controls.
    | 'cash'
    | 'truck'
    | 'return'
    | 'shield'
    | 'check'
    | 'chat'
    | 'star'
    | 'star-filled'
    | 'leaf'
    | 'gift'
    | 'clock'
    | 'tag'
    | 'box'
    | 'lock'
    | 'play'
    | 'pause'
    | 'mail'
    | 'map-pin';

interface Props {
    name: IconName;
    size?: number;
    class?: string;
}

const { name, size = 20, class: className } = Astro.props;
const filled = name === 'whatsapp' || name === 'messenger' || name === 'play' || name === 'star-filled';
---

<svg
    class:list={['icon', className]}
    viewBox="0 0 24 24"
    width={size}
    height={size}
    aria-hidden="true"
    focusable="false"
    fill={filled ? 'currentColor' : 'none'}
    stroke={filled ? 'none' : 'currentColor'}
    stroke-width="1.5"
    stroke-linecap="square"
    stroke-linejoin="miter"
>
    {name === 'search' && <path d="M10.5 17a6.5 6.5 0 1 0 0-13 6.5 6.5 0 0 0 0 13ZM15.5 15.5 20 20" />}
    {name === 'bag' && <path d="M5 8.5h14l-1 11.5H6L5 8.5ZM9 8.5V7a3 3 0 0 1 6 0v1.5" />}
    {name === 'menu' && <path d="M3.5 7h17M3.5 12h17M3.5 17h17" />}
    {name === 'close' && <path d="m6 6 12 12M18 6 6 18" />}
    {name === 'chevron-down' && <path d="m6.5 9.5 5.5 5.5 5.5-5.5" />}
    {name === 'chevron-left' && <path d="M14.5 6.5 9 12l5.5 5.5" />}
    {name === 'chevron-right' && <path d="M9.5 6.5 15 12l-5.5 5.5" />}
    {name === 'filter' && <path d="M3.5 7.5h4m4 0h9M3.5 16.5h9m4 0h4M9.5 5v5M14.5 14v5" />}
    {name === 'image' && <path d="M3.5 5.5h17v13h-17v-13ZM3.5 15.5l5-4.5 4 3.5 2.5-2 5.5 4.5M16 9.5h.5" />}
    {
        name === 'phone' && (
            <path d="M8 3.5H5.5a2 2 0 0 0-2 2.2C4.3 13.6 10.4 19.7 18.3 20.5a2 2 0 0 0 2.2-2V16l-4-1.5-2 2a12 12 0 0 1-5.5-5.5l2-2L9.5 5 8 3.5Z" />
        )
    }
    {
        name === 'whatsapp' && (
            <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4a.5.5 0 0 0 0-.4l-.8-1.9c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.9 11.9 0 0 0 4.5 4c1.7.7 2.4.8 3.2.6a2.8 2.8 0 0 0 1.8-1.3 2.3 2.3 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3Z" />
        )
    }
    {
        name === 'messenger' && (
            <path d="M12 2C6.4 2 2 6.1 2 11.7a9.4 9.4 0 0 0 3.1 7.1V22l2.9-1.6a10.7 10.7 0 0 0 4 .7c5.6 0 10-4.1 10-9.7S17.6 2 12 2Zm1 12.9-2.5-2.7-5 2.7 5.5-5.8 2.6 2.7 4.9-2.7-5.5 5.8Z" />
        )
    }
    {name === 'cash' && <path d="M3.5 6.5h17v11h-17v-11ZM12 14.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5ZM6.5 9.5v5M17.5 9.5v5" />}
    {
        name === 'truck' && (
            <path d="M2.5 6.5h11v9h-11v-9ZM13.5 9.5h4l3 3v3h-7M7 18.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3ZM17 18.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z" />
        )
    }
    {name === 'return' && <path d="M8.5 4.5 5.5 7.5l3 3M5.5 7.5H15a4.5 4.5 0 0 1 0 9H7" />}
    {
        name === 'shield' && (
            <path d="M12 3.5 19.5 6v5.5c0 4.5-3.2 7.8-7.5 9-4.3-1.2-7.5-4.5-7.5-9V6L12 3.5ZM8.5 12l2.5 2.5 4.5-5" />
        )
    }
    {name === 'check' && <path d="m5 12.5 4.5 4.5L19 7.5" />}
    {name === 'chat' && <path d="M4 5.5h16v10H10l-4 3.5v-3.5H4v-10ZM8 9.5h8M8 12.5h5" />}
    {
        (name === 'star' || name === 'star-filled') && (
            <path d="m12 3.8 2.5 5.2 5.7.8-4.1 4 1 5.6-5.1-2.7-5.1 2.7 1-5.6-4.1-4 5.7-.8L12 3.8Z" />
        )
    }
    {name === 'leaf' && <path d="M19.5 4.5c-9 0-14 4.5-14 10.5a4 4 0 0 0 4 4c6 0 10-5 10-14.5ZM5 19.5c3-4 6-6.5 9.5-8.5" />}
    {
        name === 'gift' && (
            <path d="M4 9.5h16v3H4v-3ZM5.5 12.5h13v7.5h-13v-7.5ZM12 9.5V20M12 9.5c-1-3-4.5-4.5-5.5-2.5S9 9.5 12 9.5Zm0 0c1-3 4.5-4.5 5.5-2.5S15 9.5 12 9.5Z" />
        )
    }
    {name === 'clock' && <path d="M12 20.5a8.5 8.5 0 1 0 0-17 8.5 8.5 0 0 0 0 17ZM12 7.5V12l3 2" />}
    {name === 'tag' && <path d="M3.5 12.2V4.5h7.7l9 9-7.7 7.7-9-9ZM8 9a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" />}
    {name === 'box' && <path d="M3.5 7.5 12 3.5l8.5 4v9L12 20.5l-8.5-4v-9ZM3.5 7.5 12 11.5l8.5-4M12 11.5v9" />}
    {name === 'lock' && <path d="M5.5 10.5h13v10h-13v-10ZM8.5 10.5v-3a3.5 3.5 0 0 1 7 0v3" />}
    {name === 'play' && <path d="M8 5.5v13l11-6.5-11-6.5Z" />}
    {name === 'pause' && <path d="M8.5 5.5v13M15.5 5.5v13" />}
    {name === 'mail' && <path d="M3.5 5.5h17v13h-17v-13ZM3.5 6.5l8.5 6.5 8.5-6.5" />}
    {
        name === 'map-pin' && (
            <path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11ZM12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z" />
        )
    }
</svg>
