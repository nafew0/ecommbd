---
/**
 * The storefront's own icons (CLAUDE.md, storefront design standard): drawn for us on one 24 px grid
 * with a 1.5 px stroke and square ends, no icon library. WhatsApp and Messenger are the services'
 * own marks, filled. Icons are decoration: the link or button around them carries the label.
 */
export type IconName =
    | 'search'
    | 'bag'
    | 'menu'
    | 'close'
    | 'chevron-down'
    | 'chevron-left'
    | 'chevron-right'
    | 'filter'
    | 'image'
    | 'phone'
    | 'whatsapp'
    | 'messenger';

interface Props {
    name: IconName;
    size?: number;
    class?: string;
}

const { name, size = 20, class: className } = Astro.props;
const filled = name === 'whatsapp' || name === 'messenger';
---

<svg
    class:list={['icon', className]}
    viewBox="0 0 24 24"
    width={size}
    height={size}
    aria-hidden="true"
    focusable="false"
    fill={filled ? 'currentColor' : 'none'}
    stroke={filled ? 'none' : 'currentColor'}
    stroke-width="1.5"
    stroke-linecap="square"
    stroke-linejoin="miter"
>
    {name === 'search' && <path d="M10.5 17a6.5 6.5 0 1 0 0-13 6.5 6.5 0 0 0 0 13ZM15.5 15.5 20 20" />}
    {name === 'bag' && <path d="M5 8.5h14l-1 11.5H6L5 8.5ZM9 8.5V7a3 3 0 0 1 6 0v1.5" />}
    {name === 'menu' && <path d="M3.5 7h17M3.5 12h17M3.5 17h17" />}
    {name === 'close' && <path d="m6 6 12 12M18 6 6 18" />}
    {name === 'chevron-down' && <path d="m6.5 9.5 5.5 5.5 5.5-5.5" />}
    {name === 'chevron-left' && <path d="M14.5 6.5 9 12l5.5 5.5" />}
    {name === 'chevron-right' && <path d="M9.5 6.5 15 12l-5.5 5.5" />}
    {name === 'filter' && <path d="M3.5 7.5h4m4 0h9M3.5 16.5h9m4 0h4M9.5 5v5M14.5 14v5" />}
    {name === 'image' && <path d="M3.5 5.5h17v13h-17v-13ZM3.5 15.5l5-4.5 4 3.5 2.5-2 5.5 4.5M16 9.5h.5" />}
    {
        name === 'phone' && (
            <path d="M8 3.5H5.5a2 2 0 0 0-2 2.2C4.3 13.6 10.4 19.7 18.3 20.5a2 2 0 0 0 2.2-2V16l-4-1.5-2 2a12 12 0 0 1-5.5-5.5l2-2L9.5 5 8 3.5Z" />
        )
    }
    {
        name === 'whatsapp' && (
            <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4a.5.5 0 0 0 0-.4l-.8-1.9c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.9 11.9 0 0 0 4.5 4c1.7.7 2.4.8 3.2.6a2.8 2.8 0 0 0 1.8-1.3 2.3 2.3 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3Z" />
        )
    }
    {
        name === 'messenger' && (
            <path d="M12 2C6.4 2 2 6.1 2 11.7a9.4 9.4 0 0 0 3.1 7.1V22l2.9-1.6a10.7 10.7 0 0 0 4 .7c5.6 0 10-4.1 10-9.7S17.6 2 12 2Zm1 12.9-2.5-2.7-5 2.7 5.5-5.8 2.6 2.7 4.9-2.7-5.5 5.8Z" />
        )
    }
</svg>
