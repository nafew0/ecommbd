---
import type { ResultOf } from '../lib/core';
import {
    clearFilters,
    isRefined,
    type ListingKind,
    listingQuery,
    type ListingState,
    sortOptions,
    toggleFilter,
    withState,
} from '../lib/filters';
import { pageContext } from '../lib/page';
import type { BD_SEARCH, ProductCardFields } from '../lib/queries';
import Icon from './Icon.astro';
import Pagination from './Pagination.astro';
import ProductCard from './ProductCard.astro';

/**
 * A category or search results listing (roadmap phase 13): the order, the filters with their counts,
 * removable filter chips, the products and the pages. Without JavaScript the filters are a form with
 * a "Show results" button (on phones a full-screen panel opened by `#filters`); the script applies
 * them at once on desktop and animates the phone panel.
 */
interface Props {
    kind: ListingKind;
    state: ListingState;
    result: ResultOf<typeof BD_SEARCH>['bdSearch'];
    products: Array<ResultOf<typeof ProductCardFields>>;
    /** This page's path in its language, without a query: `/product-category/men/`, `/en/search/`. */
    basePath: string;
    perPage: number;
}

const { kind, state, result, products, basePath, perPage } = Astro.props;
const { lang, defaultLang, s, format } = pageContext(Astro);
const link = (next: ListingState) => `${basePath}${listingQuery(next, kind)}`;
const refined = isRefined(state, kind);
const pages = Math.max(1, Math.ceil(result.totalItems / perPage));
const groupLabel = (filter: (typeof result.filters)[number]) =>
    filter.kind === 'option' ? (filter.key === 'size' ? s.size : s.colour) : filter.label;
const groups = result.filters.filter(filter => filter.values.length > 0);

// Chips for what's chosen, each linking to the page without it.
const chips: Array<{ label: string; href: string }> = [];
for (const filter of state.filters) {
    const known = result.filters.find(group => group.key === filter.key);
    for (const value of filter.values) {
        const label = known?.values.find(item => item.value === value)?.label ?? value;
        chips.push({ label, href: link(toggleFilter(state, filter.key, value)) });
    }
}
if (state.priceMin != null || state.priceMax != null) {
    const min = state.priceMin != null ? format.price(state.priceMin * 100) : '';
    const max = state.priceMax != null ? format.price(state.priceMax * 100) : '';
    chips.push({
        label: min && max ? `${min} – ${max}` : min ? `${min}+` : `≤ ${max}`,
        href: link(withState(state, { priceMin: null, priceMax: null })),
    });
}
if (state.inStock) chips.push({ label: s.inStockOnly, href: link(withState(state, { inStock: false })) });
const clearHref = link(clearFilters(state));
const range = result.priceRange;
---

<div class="listing" data-listing data-kind={kind}>
    <div class="listing-toolbar">
        <a class="filter-toggle" href="#filters">
            <Icon name="filter" />
            {s.filters}
        </a>
        <p class="listing-count">{s.products(result.totalItems)}</p>
        <div class="sort">
            <label for="sort-by">{s.sortBy}</label>
            <select id="sort-by" name="sort" form="filters-form">
                {
                    sortOptions(kind, !!state.q).map(option => (
                        <option value={option} selected={option === state.sort}>
                            {s.sorts[option]}
                        </option>
                    ))
                }
            </select>
            <noscript><button class="text-link" type="submit" form="filters-form">{s.applySort}</button></noscript>
        </div>
    </div>

    {
        chips.length > 0 && (
            <ul class="active-filters">
                {chips.map(chip => (
                    <li>
                        <a class="chip" href={chip.href} aria-label={s.removeFilter(chip.label)}>
                            {chip.label}
                            <Icon name="close" size={14} />
                        </a>
                    </li>
                ))}
                <li>
                    <a class="text-link" href={clearHref}>
                        {s.clearAll}
                    </a>
                </li>
            </ul>
        )
    }

    <div class="listing-body">
        <aside id="filters" class="filters" aria-label={s.filters}>
            <div class="filters-head">
                <h2>{s.filters}</h2>
                <a class="icon-button filters-close" href="#">
                    <Icon name="close" size={24} />
                    <span class="visually-hidden">{s.close}</span>
                </a>
            </div>
            <form id="filters-form" method="get" action={basePath} data-filter-form>
                {state.q && <input type="hidden" name="q" value={state.q} />}
                {
                    groups.map(filter => (
                        <details class="filter-group" open>
                            <summary>
                                {groupLabel(filter)}
                                <Icon name="chevron-down" size={18} />
                            </summary>
                            <ul>
                                {filter.values.map(value => (
                                    <li>
                                        <label class:list={['filter-option', { 'is-empty': !value.count && !value.selected }]}>
                                            <input
                                                type="checkbox"
                                                name={`filter.${filter.key}`}
                                                value={value.value}
                                                checked={value.selected}
                                                disabled={!value.count && !value.selected}
                                            />
                                            <span>{value.label}</span>
                                            <span class="filter-count">({format.number(value.count)})</span>
                                        </label>
                                    </li>
                                ))}
                            </ul>
                        </details>
                    ))
                }
                {
                    (range || state.priceMin != null || state.priceMax != null) && (
                        <details class="filter-group" open>
                            <summary>
                                {s.price}
                                <Icon name="chevron-down" size={18} />
                            </summary>
                            <div class="price-inputs">
                                <label>
                                    {s.priceFrom}
                                    <input
                                        type="text"
                                        inputmode="numeric"
                                        name="filter.price.min"
                                        value={state.priceMin ?? ''}
                                        placeholder={range ? format.price(range.min) : ''}
                                        autocomplete="off"
                                        maxlength="9"
                                    />
                                </label>
                                <label>
                                    {s.priceTo}
                                    <input
                                        type="text"
                                        inputmode="numeric"
                                        name="filter.price.max"
                                        value={state.priceMax ?? ''}
                                        placeholder={range ? format.price(range.max) : ''}
                                        autocomplete="off"
                                        maxlength="9"
                                    />
                                </label>
                            </div>
                        </details>
                    )
                }
                <details class="filter-group" open>
                    <summary>
                        {s.availability}
                        <Icon name="chevron-down" size={18} />
                    </summary>
                    <ul>
                        <li>
                            <label class="filter-option">
                                <input type="checkbox" name="filter.stock" value="in" checked={state.inStock} />
                                <span>{s.inStockOnly}</span>
                                <span class="filter-count">({format.number(result.inStockCount)})</span>
                            </label>
                        </li>
                    </ul>
                </details>
                <div class="filters-actions">
                    <button class="button" type="submit">{s.showResults}</button>
                    {refined && <a class="text-link" href={clearHref}>{s.clearAll}</a>}
                </div>
            </form>
        </aside>

        <div class="listing-results">
            {
                products.length ? (
                    <>
                        <h2 class="visually-hidden">{s.productsHeading}</h2>
                        <ul class="product-grid">
                            {products.map(product => (
                                <ProductCard product={product} lang={lang} defaultLang={defaultLang} format={format} />
                            ))}
                        </ul>
                    </>
                ) : refined ? (
                    <div class="empty-state">
                        <p>{s.noMatches}</p>
                        <p class="muted">{s.removeSomeFilters}</p>
                        <a class="button button-secondary" href={clearHref}>
                            {s.clearAll}
                        </a>
                    </div>
                ) : (
                    <div class="empty-state">
                        <slot name="empty" />
                    </div>
                )
            }
            <Pagination
                page={state.page}
                pages={pages}
                hrefFor={page => link(withState(state, { page }))}
                s={s}
                format={format}
            />
        </div>
    </div>
</div>

<script>
    import { enhanceFilters } from '../scripts/filters';

    const listing = document.querySelector<HTMLElement>('[data-listing]');
    if (listing) enhanceFilters(listing);
</script>
