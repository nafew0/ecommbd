---
import { pageContext } from '../lib/page';
import { getMenus, getTopCollections, storeName } from '../lib/store';
import { categoryPath } from '../lib/urls';
import { otherLang } from '../lib/i18n';
import Icon from './Icon.astro';
import Image from './Image.astro';

interface Props {
    /** The same page in the other language (from the page's alternates). */
    switchHref: string;
}

const { lang, settings, s, href } = pageContext(Astro);
const menus = await getMenus(lang);
// No header menu set up yet: the top categories.
const links = menus.header.length
    ? menus.header
    : (await getTopCollections(lang)).map(collection => ({
          label: collection.name,
          url: categoryPath([collection.slug]),
          children: [],
      }));
const name = storeName(settings, lang);
const linkHref = (url: string) => (url.startsWith('/') ? href(url) : url);
const query = Astro.url.pathname.endsWith('/search/') ? (Astro.url.searchParams.get('q') ?? '') : '';
---

<div class="announcement">
    <p class="container">{s.announcement}</p>
</div>
<header class="site-header">
    <div class="header-row container">
        {
            links.length > 0 && (
                <details class="menu-drawer">
                    <summary class="icon-button">
                        <Icon name="menu" size={24} class="icon-menu" />
                        <Icon name="close" size={24} class="icon-close" />
                        <span class="visually-hidden">{s.menu}</span>
                    </summary>
                    <nav class="menu-drawer-panel" aria-label={s.menu}>
                        <ul>
                            {links.map(link => (
                                <li>
                                    <a href={linkHref(link.url)}>{link.label}</a>
                                    {link.children.length > 0 && (
                                        <ul>
                                            {link.children.map(child => (
                                                <li>
                                                    <a href={linkHref(child.url)}>{child.label}</a>
                                                </li>
                                            ))}
                                        </ul>
                                    )}
                                </li>
                            ))}
                        </ul>
                    </nav>
                </details>
            )
        }
        <a class="logo" href={href('/')}>
            {
                settings.profile.logo ? (
                    <Image asset={settings.profile.logo} alt={name} lang={lang} sizes="160px" preferredWidth={160} />
                ) : (
                    <span class="logo-text">{name}</span>
                )
            }
        </a>
        {
            links.length > 0 && (
                <nav class="main-nav" aria-label={s.categories}>
                    <ul>
                        {links.map(link => (
                            <li>
                                <a href={linkHref(link.url)}>{link.label}</a>
                                {link.children.length > 0 && (
                                    <ul class="submenu">
                                        {link.children.map(child => (
                                            <li>
                                                <a href={linkHref(child.url)}>{child.label}</a>
                                            </li>
                                        ))}
                                    </ul>
                                )}
                            </li>
                        ))}
                    </ul>
                </nav>
            )
        }
        <form class="search-form" action={href('/search/')} method="get" role="search">
            <label class="visually-hidden" for="search-q">{s.search}</label>
            <input
                id="search-q"
                name="q"
                type="search"
                value={query}
                placeholder={s.searchPlaceholder}
                enterkeyhint="search"
                autocomplete="off"
                maxlength="100"
                data-suggest-label={s.searchSuggestions}
            />
            <button class="icon-button" type="submit">
                <Icon name="search" />
                <span class="visually-hidden">{s.search}</span>
            </button>
        </form>
        <div class="header-actions">
            <a class="lang-switch" href={Astro.props.switchHref} hreflang={otherLang(lang)} lang={otherLang(lang)} title={s.switchToLabel}
                >{s.switchTo}</a
            >
            <a class="icon-button cart-link" href={href('/cart/')}>
                <Icon name="bag" size={24} />
                <span class="visually-hidden">{s.cart}</span>
            </a>
        </div>
    </div>
</header>

<script>
    // Search suggestions (phase 13): the script loads the first time the search box gets focus, so
    // pages where nobody searches load none of it.
    const input = document.querySelector<HTMLInputElement>('#search-q');
    if (input) {
        const load = () => void import('../scripts/search-suggest').then(module => module.attachSuggestions(input));
        if (document.activeElement === input) load();
        else input.addEventListener('focus', load, { once: true });
    }
</script>
