---
import { type DataOf, type orderForm, pick } from '@ecommbd/sections';
import { formatBdPhone } from '@ecommbd/shared/phone';
import type { CartOrder } from '../lib/cart';
import {
    type CheckoutErrors,
    type CheckoutValues,
    initialValues,
    type PaymentOptions,
    type ShippingOption,
    type Thana,
} from '../lib/checkout';
import { pageContext } from '../lib/page';
import { percentOff, type SalesVariant, startingPack, startingVariant } from '../lib/sales';
import { salesPath } from '../lib/urls';
import type { SalesContext } from '../sections/context';
import AddressFields from './checkout/AddressFields.astro';
import ContactFields from './checkout/ContactFields.astro';
import DeliveryChoice from './checkout/DeliveryChoice.astro';
import OtpStep from './checkout/OtpStep.astro';
import PaymentChoice from './checkout/PaymentChoice.astro';
import CheckoutSummary from './CheckoutSummary.astro';
import Icon from './Icon.astro';
import Image from './Image.astro';

/**
 * A sales page's order form (roadmap phase 16): the pack (or quantity) and variant, the add-on, then
 * the checkout's own fields. On the cached page it starts empty; it posts to `/s/<slug>/order/`,
 * which answers with this same form filled in (thanas, delivery charge, total, errors, the SMS
 * code step). The script (src/scripts/sales-page.ts) sends it with fetch and swaps in the answer,
 * like the checkout's.
 */

export interface SalesChoice {
    variantId: string;
    quantity: number;
    bump: boolean;
}

export interface SalesFormState {
    values: CheckoutValues;
    errors: CheckoutErrors;
    notice: string | null;
    otp: { message: string; error?: string } | null;
    order: CartOrder | null;
    shipping: ShippingOption[];
    options: PaymentOptions | null;
    thanas: Thana[];
    csrf: string;
    idempotencyKey: string;
    stamp: string;
    choice: SalesChoice;
}

interface Props {
    sales: SalesContext;
    settings: DataOf<typeof orderForm>['settings'];
    /** After a post: what the shopper gave and what the core said. Absent on the cached page. */
    state?: SalesFormState;
}

const { sales, settings, state } = Astro.props;
const { lang, s, format, href } = pageContext(Astro);
const { page } = sales;
const product = page.product;
const variants = product.variants;
const variant =
    variants.find(item => item.id === state?.choice.variantId) ?? startingVariant(variants) ?? variants[0]!;
const packs = page.packs;
const quantity = state?.choice.quantity ?? startingPack(packs)?.quantity ?? 1;
const bump = page.bump;
const bumpChosen = !!bump && (state?.choice.bump ?? false);
// The cached page's form starts empty, with cash on delivery chosen.
const values: CheckoutValues = state?.values ?? initialValues(null);
const errors = state?.errors ?? {};
const order = state?.order ?? null;
const chosenPack = packs.find(pack => pack.quantity === quantity);
// Before the core has the order: the pack's (or the quantity's) price, and the add-on's.
const staticSubtotal =
    (chosenPack ? chosenPack.price : variant.priceWithTax * quantity) + (bumpChosen && bump ? bump.price : 0);
const total = order?.totalWithTax ?? staticSubtotal;
const deliveryKnown = !!values.districtId && !!values.thanaId && (state?.shipping.length ?? 0) > 0;
const cod = values.payment === 'cod' || !values.payment;
const button = pick(settings.button, lang) || s.orderNowShort;
const variantLabel = (item: SalesVariant) =>
    item.name.replace(product.name, '').replace(/^[\s·-]+/, '').trim() || item.name;
const packName = (n: number, label: string) => label || s.pieces(format.number(n), n === 1);
const whatsapp = Astro.locals.settings.profile.whatsapp.replace(/\D/g, '');
const phone = Astro.locals.settings.profile.phones[0];
---

{
    !page.available ? (
        <div class="order-unavailable" data-order-unavailable>
            <p class="order-unavailable-title">{s.soldOutTitle}</p>
            <p>{s.soldOutText}</p>
            {whatsapp && (
                <a
                    class="button button-whatsapp"
                    href={`https://wa.me/${whatsapp}?text=${encodeURIComponent(product.name)}`}
                    rel="noopener"
                >
                    <Icon name="whatsapp" />
                    {s.messageUs}
                </a>
            )}
        </div>
    ) : (
        <form
            method="post"
            action={href(salesPath(page.slug, 'order/'))}
            class="order-form"
            novalidate
            data-checkout-form
            data-sales-form
        >
            <input type="hidden" name="csrf" value={state?.csrf ?? ''} />
            <input type="hidden" name="idempotencyKey" value={state?.idempotencyKey ?? ''} />
            <input type="hidden" name="stamp" value={state?.stamp ?? ''} />
            <input type="hidden" name="expectedTotal" value={order?.totalWithTax ?? ''} />
            <div class="honeypot" aria-hidden="true">
                <label>
                    Website <input type="text" name="website" tabindex="-1" autocomplete="off" />
                </label>
            </div>

            {(errors.form || state?.notice) && (
                <div class="form-alert" role="alert" tabindex="-1" data-form-alert>
                    {errors.form ?? state?.notice}
                </div>
            )}

            <fieldset class="checkout-section order-choice">
                <legend>{packs.length ? s.choosePack : s.quantity}</legend>
                {variants.length > 1 ? (
                    <div class="field">
                        <label for="variantId">{s.chooseVariant}</label>
                        <select id="variantId" name="variantId" data-variant>
                            {variants.map(item => (
                                <option value={item.id} selected={item.id === variant.id} disabled={item.stockLevel === 'OUT_OF_STOCK'}>
                                    {variantLabel(item)}
                                    {item.stockLevel === 'OUT_OF_STOCK' ? ` · ${s.notEnoughStock}` : ''}
                                </option>
                            ))}
                        </select>
                    </div>
                ) : (
                    <input type="hidden" name="variantId" value={variant.id} />
                )}
                {packs.length ? (
                    <div class="pack-choices" role="radiogroup">
                        {packs.map(pack => {
                            const off = percentOff(pack.price, pack.normalPrice);
                            return (
                                <label class:list={['pack-choice', { 'pack-choice-popular': pack.popular }]}>
                                    <input
                                        type="radio"
                                        name="quantity"
                                        value={pack.quantity}
                                        checked={pack.quantity === quantity}
                                        disabled={!pack.available}
                                        data-pack
                                    />
                                    <span class="pack-choice-name">
                                        {packName(pack.quantity, pack.label)}
                                        {pack.popular && <span class="pack-flag">{s.popularPack}</span>}
                                        {!pack.available && <span class="muted"> · {s.notEnoughStock}</span>}
                                    </span>
                                    <span class="pack-choice-price">
                                        {format.price(pack.price)}
                                        {pack.normalPrice > pack.price && <s class="price-old">{format.price(pack.normalPrice)}</s>}
                                        {off > 0 && <span class="pack-off">{s.percentOff(format.number(off))}</span>}
                                    </span>
                                </label>
                            );
                        })}
                    </div>
                ) : (
                    <label class="quantity-field">
                        <span class="visually-hidden">{s.quantity}</span>
                        <input type="number" name="quantity" value={quantity} min="1" max={Math.max(1, page.maxQuantity)} inputmode="numeric" data-pack />
                    </label>
                )}
            </fieldset>

            {bump && (
                <label class="bump">
                    <input type="checkbox" name="bump" value="1" checked={bumpChosen} data-bump />
                    <span class="bump-media">
                        <Image
                            asset={bump.variant.featuredAsset ?? bump.variant.product.featuredAsset}
                            alt=""
                            lang={lang}
                            sizes="72px"
                            preferredWidth={160}
                        />
                    </span>
                    <span class="bump-text">
                        <span class="bump-heading">{s.bumpHeading}</span>
                        <strong>{bump.title}</strong>
                        {bump.text && <span class="muted">{bump.text}</span>}
                        <span class="bump-price">
                            {format.price(bump.price)}
                            {bump.normalPrice > bump.price && <s class="price-old">{format.price(bump.normalPrice)}</s>}
                        </span>
                        <span class="bump-yes">{s.addBump}</span>
                    </span>
                </label>
            )}

            <ContactFields values={values} errors={errors} settings={sales.checkout} />
            <AddressFields
                values={values}
                errors={errors}
                settings={sales.checkout}
                districts={sales.districts}
                thanas={state?.thanas ?? []}
                showNote={settings.showNote}
            />
            <DeliveryChoice
                values={values}
                shipping={state?.shipping ?? []}
                chosenShipping={order?.shippingLines[0]?.shippingMethod.id}
                free={order?.bdDelivery.freeDeliveryRemaining}
                deliveryKnown={deliveryKnown}
            />
            <PaymentChoice values={values} errors={errors} options={state?.options ?? null} order={order} cod={cod} />
            <OtpStep otp={state?.otp ?? null} />

            {order && order.lines.length ? (
                <CheckoutSummary order={order} options={state?.options ?? null} cod={cod} deliveryKnown={deliveryKnown} />
            ) : (
                <section class="checkout-summary" aria-labelledby="summary-title" data-part="summary">
                    <h2 id="summary-title">{s.orderSummary}</h2>
                    <ul class="summary-lines">
                        <li>
                            <span class="summary-media">
                                <Image asset={product.featuredAsset} alt="" lang={lang} sizes="56px" preferredWidth={160} />
                                <span class="summary-quantity">{format.number(quantity)}</span>
                            </span>
                            <span class="summary-name">{product.name}</span>
                            <span>{format.price(chosenPack ? chosenPack.price : variant.priceWithTax * quantity)}</span>
                        </li>
                        {bumpChosen && bump && (
                            <li>
                                <span class="summary-media">
                                    <Image asset={bump.variant.featuredAsset ?? bump.variant.product.featuredAsset} alt="" lang={lang} sizes="56px" preferredWidth={160} />
                                    <span class="summary-quantity">{format.number(1)}</span>
                                </span>
                                <span class="summary-name">{bump.title}</span>
                                <span>{format.price(bump.price)}</span>
                            </li>
                        )}
                    </ul>
                    <dl class="summary-totals">
                        <div>
                            <dt>{s.deliveryCharge}</dt>
                            <dd>—</dd>
                        </div>
                        <div class="summary-total">
                            <dt>{s.total}</dt>
                            <dd>{format.price(total)}</dd>
                        </div>
                    </dl>
                    <p class="field-hint">{s.chooseDistrictFirst}</p>
                </section>
            )}

            <div class="checkout-actions">
                <button class="button place-button" type="submit" name="action" value="place" data-place data-placing={s.placing}>
                    {`${button} · ${format.price(total)}`}
                </button>
                {cod && <p class="pay-note">{s.payOnReceive}</p>}
                <p class="form-status" role="status" aria-live="polite" data-status data-offline={s.noConnection}></p>
            </div>
        </form>
    )
}
{
    settings.help && (whatsapp || phone) && (
        <p class="order-help">
            <span>{s.salesHelp}</span>
            {phone && (
                <a class="text-link" href={`tel:${phone}`}>
                    {formatBdPhone(phone)}
                </a>
            )}
            {whatsapp && (
                <a class="text-link" href={`https://wa.me/${whatsapp}`} rel="noopener">
                    WhatsApp
                </a>
            )}
        </p>
    )
}
