---
import type { Lang } from '../lib/i18n';
import { t } from '../lib/i18n';
import Icon from './Icon.astro';

/** WhatsApp, Messenger and call buttons from store settings: plain links, no widget script. */
interface Props {
    lang: Lang;
    whatsapp: string;
    messengerUrl: string;
    phone: string | undefined;
}

const { lang, whatsapp, messengerUrl, phone } = Astro.props;
const s = t(lang);
---

{
    (whatsapp || messengerUrl || phone) && (
        <div class="floating-contact">
            {whatsapp && (
                <a
                    class="float-button float-whatsapp"
                    href={`https://wa.me/${whatsapp.replace(/\D/g, '')}`}
                    rel="noopener"
                    aria-label={s.chatWhatsapp}
                    title={s.chatWhatsapp}
                >
                    <Icon name="whatsapp" size={26} />
                </a>
            )}
            {messengerUrl && (
                <a
                    class="float-button float-messenger"
                    href={messengerUrl}
                    rel="noopener"
                    aria-label={s.chatMessenger}
                    title={s.chatMessenger}
                >
                    <Icon name="messenger" size={26} />
                </a>
            )}
            {phone && (
                <a class="float-button float-call" href={`tel:${phone}`} aria-label={s.callUs} title={s.callUs}>
                    <Icon name="phone" size={24} />
                </a>
            )}
        </div>
    )
}
