---
import type { Lang } from '../lib/i18n';
import { t } from '../lib/i18n';

/** WhatsApp, Messenger and call buttons from store settings: plain links, no widget script. */
interface Props {
    lang: Lang;
    whatsapp: string;
    messengerUrl: string;
    phone: string | undefined;
}

const { lang, whatsapp, messengerUrl, phone } = Astro.props;
const s = t(lang);
---

{
    (whatsapp || messengerUrl || phone) && (
        <div class="floating-contact">
            {whatsapp && (
                <a
                    class="float-button float-whatsapp"
                    href={`https://wa.me/${whatsapp.replace(/\D/g, '')}`}
                    rel="noopener"
                    aria-label={s.chatWhatsapp}
                    title={s.chatWhatsapp}
                >
                    <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
                        <path
                            fill="currentColor"
                            d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4a.5.5 0 0 0 0-.4l-.8-1.9c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.9 11.9 0 0 0 4.5 4c1.7.7 2.4.8 3.2.6a2.8 2.8 0 0 0 1.8-1.3 2.3 2.3 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3Z"
                        />
                    </svg>
                </a>
            )}
            {messengerUrl && (
                <a
                    class="float-button float-messenger"
                    href={messengerUrl}
                    rel="noopener"
                    aria-label={s.chatMessenger}
                    title={s.chatMessenger}
                >
                    <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
                        <path
                            fill="currentColor"
                            d="M12 2C6.4 2 2 6.1 2 11.7a9.4 9.4 0 0 0 3.1 7.1V22l2.9-1.6a10.7 10.7 0 0 0 4 .7c5.6 0 10-4.1 10-9.7S17.6 2 12 2Zm1 12.9-2.5-2.7-5 2.7 5.5-5.8 2.6 2.7 4.9-2.7-5.5 5.8Z"
                        />
                    </svg>
                </a>
            )}
            {phone && (
                <a class="float-button float-call" href={`tel:${phone}`} aria-label={s.callUs} title={s.callUs}>
                    <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
                        <path
                            fill="currentColor"
                            d="M6.6 10.8a15.2 15.2 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.2 11.4 11.4 0 0 0 3.6.6 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.2.2 2.5.6 3.6a1 1 0 0 1-.3 1l-2.2 2.2Z"
                        />
                    </svg>
                </a>
            )}
        </div>
    )
}
