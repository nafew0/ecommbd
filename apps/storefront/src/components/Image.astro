---
import { type AssetData, imageAttributes } from '../lib/images';
import { t, type Lang } from '../lib/i18n';

interface Props {
    asset: AssetData | null | undefined;
    alt: string;
    /** How wide the image shows, for the browser to pick a size: `(min-width: 768px) 50vw, 100vw`. */
    sizes: string;
    lang: Lang;
    /** The page's main image (LCP): loaded at once with high priority. Everything else is lazy. */
    priority?: boolean;
    preferredWidth?: number;
    class?: string;
}

const { asset, alt, sizes, lang, priority = false, preferredWidth, class: className } = Astro.props;
const attributes = asset ? imageAttributes(asset, preferredWidth) : null;
---

{
    attributes ? (
        <img
            src={attributes.src}
            srcset={attributes.srcset}
            sizes={attributes.srcset ? sizes : undefined}
            width={attributes.width}
            height={attributes.height}
            alt={alt}
            loading={priority ? 'eager' : 'lazy'}
            decoding={priority ? 'sync' : 'async'}
            fetchpriority={priority ? 'high' : undefined}
            class={className}
        />
    ) : (
        <div class:list={['image-placeholder', className]} role="img" aria-label={t(lang).noImage}>
            <svg viewBox="0 0 24 24" width="40" height="40" aria-hidden="true">
                <path
                    fill="currentColor"
                    d="M21 5v14H3V5h18m0-2H3a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h18a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2Zm-7.1 9.1-2.8 3.6-2-2.4L6 17h12l-4.1-4.9Z"
                />
            </svg>
        </div>
    )
}
