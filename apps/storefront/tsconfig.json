{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src/**/*", "test/**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "paths": {
      "@ecommbd/shared/*": ["../../packages/shared/src/*"],
      "@ecommbd/sections": ["../../packages/sections/src/index.ts"]
    },
    "plugins": [
      {
        "name": "gql.tada/ts-plugin",
        "schema": "./src/gql/shop-schema.graphql",
        "tadaOutputLocation": "./src/gql/graphql-env.d.ts"
      }
    ]
  }
}
