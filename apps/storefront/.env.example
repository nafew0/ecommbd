# Storefront settings (apps/storefront/src/env.ts). Copy to .env, or set them in the process manager.

# dev | test | staging | production
APP_ENV=dev
# The core on this server; the storefront calls <CORE_URL>/shop-api
CORE_URL=http://localhost:3000
# Milliseconds before a Shop API call counts as failed (the page then answers 503)
CORE_TIMEOUT_MS=5000
# The store's public address, for canonical URLs, sitemaps and Open Graph (required in staging and production)
SITE_URL=http://localhost:4321
# live | maintenance | suspended (a bilingual 503 page)
STOREFRONT_STATE=live

# The cache Redis (root docker-compose.yml). Leave empty to cache in the process only.
REDIS_CACHE_HOST=127.0.0.1
REDIS_CACHE_PORT=63791
REDIS_CACHE_USERNAME=
REDIS_CACHE_PASSWORD=
# The store's own Redis key prefix, the same as the core's
REDIS_KEY_PREFIX=ecommbd-dev
# Seconds store settings, menus and categories stay cached
CACHE_TTL_SECONDS=60
# Extra origins for the Content Security Policy, comma-separated (a store's analytics, later)
CSP_ALLOWED_ORIGINS=
# Signs the checkout form (CSRF token, form timing). Required in staging and production: 32+ random
# characters, e.g. `openssl rand -hex 32`. Development uses a fixed one when empty.
CSRF_SECRET=

# Read by server.mjs
PORT=4321
HOST=0.0.0.0
# Pass /img, /assets and /shop-api to the core (development; Nginx does this in production)
PROXY_CORE=true
